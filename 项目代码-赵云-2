FORMAT = pyaudio.paInt16
CHANNELS = 1
RATE = 16000
CHUNK_DURATION_MS = 30
CHUNK = int(RATE * CHUNK_DURATION_MS / 1000)

def record_audio_vad():
    vad = webrtcvad.Vad()
    vad.set_mode(3)
    p = pyaudio.PyAudio()
    stream = p.open(format=FORMAT,
                    channels=CHANNELS,
                    rate=RATE,
                    input=True,
                    frames_per_buffer=CHUNK)
    print("🎤 请说话... (自动检测，静音后自动结束，最长录音30秒)")
    frames = []
    triggered = False
    silence_frames = 0
    SILENCE_DURATION_SEC = 1.5
    SILENCE_THRESHOLD = int(SILENCE_DURATION_SEC / (CHUNK_DURATION_MS / 1000.0))
    MAX_RECORD_SEC = 30
    max_frames = int(MAX_RECORD_SEC / (CHUNK_DURATION_MS / 1000.0))
    started = False

    while True:
        frame = stream.read(CHUNK, exception_on_overflow=False)
        is_speech = vad.is_speech(frame, RATE)
        if not triggered:
            if is_speech:
                triggered = True
                started = False
                if not started:
                    print("🔴 录音开始...")
                    started = True
                frames.append(frame)
        else:
            frames.append(frame)
            if len(frames) >= max_frames:
                print("⚠️ 达到最大录音时长，自动结束。")
                break
            if not is_speech:
                silence_frames += 1
                if silence_frames >= SILENCE_THRESHOLD:
                    print("🔇 静音结束，录音完成。")
                    break
            else:
                silence_frames = 0

    stream.stop_stream()
    stream.close()
    p.terminate()

    with tempfile.NamedTemporaryFile(delete=False, suffix='.wav') as tmpfile:
        wf = wave.open(tmpfile.name, 'wb')
        wf.setnchannels(CHANNELS)
        wf.setsampwidth(p.get_sample_size(FORMAT))
        wf.setframerate(RATE)
        wf.writeframes(b''.join(frames))
        wf.close()
        return tmpfile.name

def record_audio():
    return record_audio_vad()

def asr_file(audio_file):
    print("🎤 正在识别录音...")
    try:
        messages = [
            {"role": "user", "content": [{"audio": audio_file}]}
        ]
        response = dashscope.MultiModalConversation.call(
            model="qwen3-asr-flash",
            messages=messages,
            api_key=MY_API_KEY
        )
        if response.status_code == 200:
            text = response.output.choices[0].message.content[0].get('text', '')
            if text:
                print(f"📝 识别结果: {text}")
                return text
            else:
                print("⚠️ 未能从响应中提取到有效文本。")
                return None
        else:
            print(f"❌ ASR API调用失败，状态码: {response.status_code}")
            print(f"   错误信息: {response.message}")
            return None
    except Exception as e:
        print(f"❌ ASR过程发生异常: {e}")
        import traceback
        traceback.print_exc()
        return None

